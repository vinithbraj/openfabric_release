# Track shared runtime SQLite seed/state databases while leaving non-database
# runtime artifacts ignored. The parameter store stays ignored because it can
# contain private connection details and secrets.
!/artifacts/
/artifacts/*
!/artifacts/*.db
/artifacts/agent_gateways.db
/artifacts/agent_events.db
/artifacts/agent_parameters.db
/artifacts/agent_tasks.db
/artifacts/agent_ui_settings.db
/artifacts/chats.db
/artifacts/runtime.db

# Track the macOS release binary artifacts (large binaries stored via Git LFS).
# They live under the gitignored `dist/` tree, so re-include the parent
# directories first; .DS_Store stays ignored via the global .DS_Store rule above.
!MACOS/dist/
!MACOS/dist/binary/
